[Unit]
Description=FastAPI LLM Webhook Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/llm-webhook
EnvironmentFile=/opt/llm-webhook/.env
ExecStart=/opt/llm-webhook/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
